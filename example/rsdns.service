# Example systemd unit for rsdns.
#
# Type=notify: systemd waits until rsdns sends READY=1 over $NOTIFY_SOCKET
# (after all UDP/TCP listeners and the ui endpoint are bound), then
# marks the service active.  Without systemd (no $NOTIFY_SOCKET) rsdns runs
# as usual and the notification is skipped.
#
# ExecReload: `systemctl reload rsdns` sends SIGHUP, which makes rsdns
# reopen its query log file (dir/query.log).  That is what an external
# logrotate needs after renaming the file — see example/rsdns.logrotate.
# SIGHUP does NOT reload the configuration: rule / upstream / cache changes
# still require a restart.
#
# Install:
#   sudo cp example/rsdns.service /etc/systemd/system/rsdns.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rsdns

[Unit]
Description=rsdns DNS server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/rsdns --config /etc/rsdns/rsdns.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
